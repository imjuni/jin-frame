{
  "name": "@jin-frame/generator-core",
  "version": "1.0.0",
  "description": "A core module for generating jin-frame classes from an OpenAPI specification.",
  "engines": {
    "node": "^22.23.4"
  },
  "scripts": {
    "openapi-typescript-example": "pnpm dlx openapi-typescript ./samples/v3.yml -o petstore.d.ts",
    "clean": "rimraf dist",
    "dts": "tsc -p tsconfig.dts.json",
    "dts-gen": "rollup --config .configs/rollup.config.mjs",
    "dts-pack": "run-s dts dts-gen dts-rm",
    "dts-rm": "rimraf dist/types/origin",
    "esbuild-esm": "node .configs/esbuild.mjs",
    "bundle-pack": "run-p esbuild-esm dts-pack",
    "bundle": "run-s clean ctix bundle-pack ctix-rm",
    "build": "tsc --incremental --noEmit --project tsconfig.json --tsBuildInfoFile .tsbuildinfo",
    "swd": "swd",
    "test": "vitest run --coverage",
    "test:hook": "vitest run --coverage --silent",
    "ctix": "ctix build --config .configs/.ctirc",
    "ctix-rm": "ctix remove --force-yes --remove-backup",
    "lint": "oxlint .",
    "lint-staged": "pnpm run check:write",
    "pub": "pnpm publish --registry http://localhost:8901",
    "unpub": "pnpm unpublish typescript-cli-boilerplate@$npm_package_version --registry http://localhost:8901 --force",
    "pub:prod": "RELEASE_MODE=true pnpm publish --access=public",
    "dd": "deps-diff md -d prod -d dev --title-list-type 'm' --deps-list-type 'm' --content-list-type 'm'",
    "check": "ultracite check",
    "check:write": "ultracite fix",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "prepack": "run-s bundle",
    "prepublishOnly": "node prepublish.cjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/imjuni/jin-frame.git"
  },
  "keywords": [],
  "author": "ByungJoon Lee",
  "license": "MIT",
  "main": "dist/esm/index.mjs",
  "types": "dist/types/index.d.ts",
  "imports": {
    "#generators/*.js": {
      "types": "./src/generators/*.ts",
      "default": "./src/generators/*.ts"
    },
    "#https/*.js": {
      "types": "./src/https/*.ts",
      "default": "./src/https/*.ts"
    },
    "#models/*.js": {
      "types": "./src/models/*.ts",
      "default": "./src/models/*.ts"
    },
    "#openapi/*.js": {
      "types": "./src/openapi/*.ts",
      "default": "./src/openapi/*.ts"
    },
    "#renderers/*.js": {
      "types": "./src/renderers/*.ts",
      "default": "./src/renderers/*.ts"
    },
    "#tools/*.js": {
      "types": "./src/tools/*.ts",
      "default": "./src/tools/*.ts"
    }
  },
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/index.mjs",
      "default": "./dist/esm/index.mjs"
    }
  },
  "files": [
    "dist",
    "templates/**/*.eta"
  ],
  "bugs": {
    "url": "https://github.com/imjuni/jin-frame/issues"
  },
  "homepage": "https://imjuni.github.io/jin-frame",
  "devDependencies": {
    "@rollup/plugin-node-resolve": "^15.2.3",
    "@tsconfig/node22": "^22.0.6",
    "@types/node": "^22.20.5",
    "@types/source-map-support": "^0.5.7",
    "@types/swagger2openapi": "^7.0.4",
    "@types/traverse": "^0.6.37",
    "@types/yargs": "^17.0.24",
    "@vitest/coverage-v8": "^4.1.9",
    "cross-env": "^10.0.0",
    "ctix": "^2.7.1",
    "deps-diff": "^1.0.2",
    "esbuild": "0.25.5",
    "npm-run-all": "^4.1.5",
    "openapi-typescript": "^7.9.1",
    "read-pkg": "^5.2.0",
    "rimraf": "^5.0.1",
    "rollup": "^4.50.1",
    "rollup-plugin-dts": "^6.1.0",
    "shortsword": "^0.4.0",
    "tslib": "^2.5.2",
    "tsx": "^4.20.3",
    "typescript": "6.0.3",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.8"
  },
  "dependencies": {
    "@apidevtools/json-schema-ref-parser": "^15.3.5",
    "change-case": "^5.4.4",
    "eta": "3.5.0",
    "jin-frame": "workspace:*",
    "my-easy-fp": "^0.22.0",
    "my-node-fp": "^0.10.3",
    "openapi-schema-validator": "^12.1.3",
    "openapi-types": "^12.1.3",
    "pathe": "^2.0.3",
    "source-map-support": "^0.5.21",
    "swagger2openapi": "^7.0.8",
    "type-fest": "^5.7.0",
    "url-join": "^5.0.0",
    "yaml": "^2.8.1"
  },
  "peerDependencies": {
    "openapi-typescript": ">=7",
    "typescript": ">=6"
  }
}
