{
  "name": "jin-frame",
  "version": "5.1.0",
  "description": "Reusable HTTP API request definition library",
  "packageManager": "pnpm@10.16.0",
  "scripts": {
    "build:ne": "tsc --noEmit --incremental --project tsconfig.prod.json",
    "build": "pnpm run clean && tsc --incremental --project tsconfig.prod.json",
    "dts": "tsc -p tsconfig.dts.json",
    "dts-alias": "tsc-alias -p tsconfig.dts.json",
    "dts-gen": "rollup --config .configs/rollup.config.mjs",
    "dts-pack": "run-s dts dts-alias dts-gen dts-rm",
    "dts-rm": "rimraf dist/types/origin",
    "esbuild-cjs": "FORMAT=cjs node .configs/esbuild.mjs",
    "esbuild-esm": "FORMAT=esm node .configs/esbuild.mjs",
    "bundle-pack": "run-p esbuild-cjs esbuild-esm dts-pack",
    "bundle": "run-s clean ctix bundle-pack ctix-rm",
    "pub": "pnpm run bundle && cross-env RELEASE_MODE=true pnpm publish --registry http://localhost:8901",
    "unpub": "pnpm unpublish $npm_package_name@$npm_package_version --registry http://localhost:8901 --force",
    "pub:prod": "pnpm run bundle && cross-env RELEASE_MODE=true pnpm publish --access=public",
    "clean": "rimraf dist",
    "lint": "pnpm run check",
    "lint:silent": "pnpm run check",
    "lint-staged": "pnpm run check:write",
    "test:only": "vitest run --coverage",
    "test:silent": "vitest run --coverage --silent",
    "test": "vitest run --coverage",
    "swd": "swd",
    "ctix": "ctix build --config .configs/.ctirc",
    "ctix-rm": "ctix remove --force-yes --remove-backup",
    "dd": "deps-diff md -d dev -d prod -d peer --title-list-type 'm' --deps-list-type 'm' --content-list-type 'm'",
    "httpd": "http-server ./docs -p 19983",
    "prepublishOnly": "node prepublish.cjs",
    "docs:typedoc": "typedoc --options .configs/typedoc.json",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:build:prod": "BASE_DIR='/jin-frame/' vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "biome": "biome",
    "check": "biome check --config-path=biome.json .",
    "check:write": "biome check --config-path=biome.json --write .",
    "format": "biome format --config-path=biome.json --write .",
    "format:check": "biome format --config-path=biome.json ."
  },
  "keywords": [
    "http",
    "declarative",
    "decorator",
    "http-client",
    "typescript",
    "request",
    "fetch"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/imjuni/jin-frame.git"
  },
  "engines": {
    "node": ">=22"
  },
  "author": "ByungJoon Lee <imjuni+github@gmail.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/imjuni/jin-frame/issues"
  },
  "main": "dist/cjs/index.cjs",
  "module": "dist/esm/index.mjs",
  "types": "dist/types/index.d.ts",
  "exports": {
    ".": {
      "require": {
        "types": "./dist/types/index.d.ts",
        "default": "./dist/cjs/index.cjs"
      },
      "import": {
        "types": "./dist/types/index.d.ts",
        "default": "./dist/esm/index.mjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "homepage": "https://imjuni.github.io/jin-frame",
  "dependencies": {
    "dot-prop": "^6.0.1",
    "http-status-codes": "^2.3.0",
    "merge": "^2.1.1",
    "my-easy-fp": "^0.23.0",
    "reflect-metadata": "^0.2.2",
    "type-fest": "^4.41.0",
    "url-template": "^3.1.1"
  },
  "devDependencies": {
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@tsconfig/node22": "^22.0.5",
    "@types/node": "22.19.17",
    "@vitest/coverage-v8": "^4.1.5",
    "@vitest/ui": "^4.1.5",
    "cross-env": "^10.1.0",
    "ctix": "^2.7.1",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "debug": "^4.3.4",
    "deps-diff": "^1.0.2",
    "esbuild": "^0.28.0",
    "http-server": "^14.1.1",
    "jsonc-parser": "^3.2.0",
    "mermaid": "^11.12.0",
    "msw": "^2.13.6",
    "npm-run-all": "^4.1.5",
    "read-pkg": "^5.2.0",
    "rimraf": "^5.0.5",
    "rollup": "^4.5.0",
    "rollup-plugin-dts": "^6.4.1",
    "shortsword": "^0.4.0",
    "tsc-alias": "^1.8.8",
    "tsconfig-paths": "^4.2.0",
    "tslib": "^2.6.2",
    "typedoc": "^0.28.19",
    "typedoc-plugin-markdown": "^4.8.0",
    "typedoc-vitepress-theme": "^1.1.2",
    "typescript": "6.0.3",
    "vite-tsconfig-paths": "^6.1.1",
    "vitepress": "^1.6.4",
    "vitest": "^4.1.5",
    "zod": "^4.1.11"
  },
  "directories": {
    "test": "test"
  }
}
