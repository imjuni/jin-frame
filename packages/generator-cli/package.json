{
  "name": "@jin-frame/generator-cli",
  "version": "1.0.0",
  "description": "A CLI tool for generating jin-frame classes from an OpenAPI specification.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "swagger-example": "pnpm dlx openapi-typescript ./samples/v3.yml -o petstore.d.ts",
    "clean": "rimraf dist",
    "dev": "tsx src/cli.ts",
    "debug": "tsx --inspect-brk src/cli.ts",
    "prebuild": "pnpm run clean",
    "build": "tsc --incremental --noEmit --project tsconfig.json --tsBuildInfoFile .tsbuildinfo",
    "esbuild-cjs": "FORMAT=cjs node .configs/esbuild.mjs",
    "esbuild-esm": "FORMAT=esm node .configs/esbuild.mjs",
    "bundle-pack": "run-p esbuild-cjs esbuild-esm",
    "bundle": "run-s clean bundle-pack",
    "test": "vitest run --coverage",
    "lint": "pnpm run check",
    "lint-staged": "pnpm run check:write",
    "pub": "pnpm publish --registry http://localhost:8901",
    "unpub": "pnpm unpublish typescript-cli-boilerplate@$npm_package_version --registry http://localhost:8901 --force",
    "pub:prod": "RELEASE_MODE=true pnpm publish --access=public",
    "dd": "deps-diff md -d prod -d dev --title-list-type 'm' --deps-list-type 'm' --content-list-type 'm'",
    "biome": "biome",
    "check": "biome check --config-path=biome.json .",
    "check:write": "biome check --config-path=biome.json --write .",
    "format": "biome format --config-path=biome.json --write .",
    "format:check": "biome format --config-path=biome.json .",
    "prepublishOnly": "node prepublish.cjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/imjuni/jin-frame.git"
  },
  "keywords": [],
  "author": "ByungJoon Lee",
  "license": "MIT",
  "main": "dist/cjs/cli.cjs",
  "module": "dist/esm/cli.mjs",
  "bin": {
    "frame-cli": "dist/cjs/cli.cjs"
  },
  "exports": {
    ".": {
      "require": "./dist/cjs/cli.cjs",
      "import": "./dist/esm/cli.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "imports": {
    "#builders/*.js": {
      "types": "./src/builders/*.ts",
      "default": "./src/builders/*.ts"
    },
    "#commands/*.js": {
      "types": "./src/commands/*.ts",
      "default": "./src/commands/*.ts"
    },
    "#handlers/*.js": {
      "types": "./src/handlers/*.ts",
      "default": "./src/handlers/*.ts"
    },
    "#interfaces/*.js": {
      "types": "./src/interfaces/*.ts",
      "default": "./src/interfaces/*.ts"
    },
    "#schema/*.js": {
      "types": "./src/schema/*.ts",
      "default": "./src/schema/*.ts"
    },
    "#transforms/*.js": {
      "types": "./src/transforms/*.ts",
      "default": "./src/transforms/*.ts"
    },
    "#validators/*.js": {
      "types": "./src/validators/*.ts",
      "default": "./src/validators/*.ts"
    }
  },
  "bugs": {
    "url": "https://github.com/imjuni/jin-frame/issues"
  },
  "homepage": "https://imjuni.github.io/jin-frame",
  "devDependencies": {
    "@tsconfig/node20": "^20.1.6",
    "@types/babel__helper-validator-identifier": "^7.15.2",
    "@types/node": "^20.19.14",
    "@types/source-map-support": "^0.5.10",
    "@types/swagger2openapi": "^7.0.4",
    "@types/traverse": "^0.6.37",
    "@vitest/coverage-v8": "3.2.4",
    "cross-env": "^10.0.0",
    "deps-diff": "^1.0.2",
    "esbuild": "0.25.5",
    "npm-run-all": "^4.1.5",
    "openapi-typescript": "^7.13.0",
    "read-pkg": "^5.2.0",
    "rimraf": "^5.0.10",
    "shortsword": "^0.4.0",
    "ts-node": "^10.9.2",
    "tslib": "^2.8.1",
    "tsx": "^4.20.5",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@apidevtools/json-schema-ref-parser": "^14.2.1",
    "@babel/helper-validator-identifier": "^7.27.1",
    "@jin-frame/generator-core": "workspace:*",
    "c12": "4.0.0-beta.5",
    "change-case": "^5.4.4",
    "citty": "^0.2.2",
    "consola": "^3.4.2",
    "defu": "^6.1.7",
    "my-easy-fp": "^0.22.0",
    "my-node-fp": "^0.10.3",
    "openapi-schema-validator": "^12.1.3",
    "openapi-types": "^12.1.3",
    "pathe": "^2.0.3",
    "rosetta": "^1.1.0",
    "source-map-support": "^0.5.21",
    "swagger2openapi": "^7.0.8",
    "type-fest": "^4.41.0",
    "yaml": "^2.8.1",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "openapi-typescript": ">=7",
    "ts-morph": ">=26",
    "typescript": ">=6"
  }
}
