{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^bundle"],
      "outputs": ["*.tsbuildinfo"]
    },
    "jin-frame#build": {
      "outputs": []
    },
    "bundle": {
      "dependsOn": ["^bundle"],
      "outputs": ["dist/**"]
    },
    "test:hook": {
      "dependsOn": ["build"],
      "outputs": ["coverage/**"]
    }
  }
}
