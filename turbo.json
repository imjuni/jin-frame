{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^bundle"],
      "outputs": ["*.tsbuildinfo"]
    },
    "jin-frame#build": {
      "outputs": []
    },
    "bundle": {
      "dependsOn": ["^bundle"],
      "outputs": ["dist/**"]
    },
    "test:hook": {
      "dependsOn": ["build"],
      "outputs": ["coverage/**"]
    },
    "@jin-frame/docs#build": {
      "dependsOn": ["jin-frame#bundle", "@jin-frame/generator-core#build"],
      "env": ["BASE_DIR"],
      "cache": false,
      "outputs": ["src/.vitepress/dist/**"]
    }
  }
}
