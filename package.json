{
  "name": "jin-frame-workspace",
  "private": true,
  "packageManager": "pnpm@10.16.0",
  "engines": {
    "node": "^22.23.4"
  },
  "scripts": {
    "docs:typedoc": "pnpm --filter @jin-frame/docs run docs:typedoc",
    "docs:build": "pnpm --filter @jin-frame/docs run build",
    "check": "ultracite check",
    "check:write": "ultracite fix",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint .",
    "build": "turbo run build",
    "bundle": "turbo run bundle",
    "test:hook": "turbo run test:hook",
    "prepare": "husky",
    "docs:dev": "pnpm --filter @jin-frame/docs run dev",
    "docs:preview": "pnpm --filter @jin-frame/docs run preview"
  },
  "devDependencies": {
    "husky": "9.1.7",
    "jiti": "^2.7.0",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "turbo": "^2.10.2",
    "ultracite": "7.12.2"
  }
}
